{
  "name": "smart-shoots-desktop",
  "version": "1.0.0",
  "description": "SMART SHOOTS Desktop Application",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "author": "Ahmed Gouda",
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.smartshoots.app",
    "productName": "SMART SHOOTS",
    "files": [
      "main.js",
      "preload.js"
    ],
    "extraResources": [
      {
        "from": "build-resources/backend",
        "to": "backend",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true
    }
  },
  "allowScripts": {
    "electron@31.7.7": true
  }
}
