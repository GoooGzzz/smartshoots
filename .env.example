# Copy this file to ".env" (same folder as docker-compose.yml) and fill
# in real values. ".env" itself should NOT be committed/shared - it holds
# your admin password and secret key.

# The domain (or free dynamic-DNS name) pointing at this server's IP.
# See DEPLOY.md if you don't already own a domain.
DOMAIN=smartshoots.example.com

# A long random string, unique to this deployment. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SMARTSHOOTS_SECRET_KEY=changeme-generate-a-real-random-value

# Password for the auto-created "admin" account on first startup.
# Change this from Settings inside the app after your first login too.
SMARTSHOOTS_ADMIN_PASSWORD=changeme
